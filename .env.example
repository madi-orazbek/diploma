# App
NEXT_PUBLIC_APP_URL=http://localhost:8080
NODE_ENV=development

# MongoDB (current runtime stack)
MONGODB_URI=mongodb+srv://danel:0000@cluster0.iocfhez.mongodb.net/Diploma?appName=Cluster0

# JWT
JWT_SECRET=replace_with_secure_secret

# Email (optional)
